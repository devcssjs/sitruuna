# Copy this file, rename the copy to ".env", and fill in the values.
# NEVER share .env or upload it anywhere. .gitignore already keeps it out of git.

# Which AI reads your emails: gemini (free) or claude (paid, switch later)
LLM_PROVIDER=gemini

# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Get from https://platform.claude.com (only needed when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=

# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Leave empty at first. Start the bot, send it /start, and it will tell you this number.
TELEGRAM_CHAT_ID=

# Notion (optional). Token: app.notion.com/developers/connections -> your "Sitruuna"
# internal connection -> Configuration. Page: the empty "Sitruuna HQ" page -> Share -> Copy link.
NOTION_TOKEN=
NOTION_HQ_PAGE=
